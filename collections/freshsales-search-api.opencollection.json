{
  "opencollection": "1.0.0",
  "info": {
    "name": "Freshsales CRM Appointments Search API",
    "version": "2026-05-23"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{bundleAlias}.myfreshworks.com/crm/sales/api/search",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}